# aside-relay configuration — copy to ~/.aside-relay/env (or <repo>/.env)
# Every key is optional; the bridge runs loopback-only with none of them set.
# Real environment variables override this file.
# `~` expands to your home dir on both macOS and Windows (%USERPROFILE%).

# --- binding ---
#ASIDE_RELAY_HOST=127.0.0.1
#ASIDE_RELAY_PORT=8799

# --- auth ---
# Bearer token file (the wizard generates ~/.aside-relay/token for you)
#ASIDE_RELAY_TOKEN_FILE=~/.aside-relay/token

# --- Aside paths (defaults fit a standard install) ---
# macOS default only; Windows looks up `aside` on PATH, then
# %LOCALAPPDATA%\Aside\CLI\current\aside.exe — leave unset there.
#ASIDE_BIN=~/.local/bin/aside
# CLI account id; must match ASIDE_USER_DIR (u0 -> ~/.aside/u/0). Empty = CLI default.
#ASIDE_ACCOUNT=u0
#ASIDE_USER_DIR=~/.aside/u/0
#ASIDE_DAEMON_URL=http://127.0.0.1:21420

# --- Cloudflare Access bootstrap (for phone / remote use) ---
#ASIDE_RELAY_ACCESS_TEAM=yourteam.cloudflareaccess.com
#ASIDE_RELAY_ACCESS_AUD=<Access application AUD tag>
#ASIDE_RELAY_ACCESS_EMAILS=you@example.com
# service-token JSON ({"client_id": ..., "client_secret": ...}) for native shells
#ASIDE_RELAY_CF_SERVICE_TOKEN_FILE=~/.aside-relay/cf_service_token.json
# extra allowed service-token common names, comma separated
#ASIDE_RELAY_ACCESS_CNS=

# --- push notification on run completion (ntfy protocol) ---
# Browser Web Push keys and subscriptions persist here; no Apple developer account is needed.
#ASIDE_RELAY_WEB_PUSH_DIR=~/.aside-relay/web-push
#ASIDE_RELAY_NTFY=https://ntfy.sh
#ASIDE_RELAY_NTFY_TOPIC=my-unique-topic
#ASIDE_RELAY_NTFY_ENABLED=1

# --- upload limit (bytes) ---
#ASIDE_RELAY_UPLOAD_MAX=25165824

# --- persistent follow-up queue ---
#ASIDE_RELAY_FOLLOWUPS_FILE=~/.aside-relay/followups.json
